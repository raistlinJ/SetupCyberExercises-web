# Copy this file to .env in the project root.
# Use 1 to enable a plugin or 0 to disable it. Values below match the defaults.
# After changing these values, restart the app; with Docker Compose, run:
# docker compose up -d --build app

# CTFd Manager: configure each project's CTFd connection through Connection.
CTFD_PLUGIN_ENABLE=1

# CTF-RPG Manager: configure each project's CTF-RPG connection through Connection.
CTFRPG_PLUGIN_ENABLE=1

# Agent: adds Commands > Plugins > agent in VM Manager.
# Configure its model, endpoint, and API key in the agent dialog.
AGENT_PLUGIN_ENABLE=0

# AccessForge: adds the Credential Checkouts tab. Configure the administrator
# URL and credentials through Connection in that tab.
# The destination AccessForge server separately needs ENABLE_ACCOUNT_CHECKOUT=true.
ACCESSFORGE_PLUGIN_ENABLE=0

# Optional VM Manager feature (separate from plugins): orchestration permissions.
ORCHESTRATION_PERMISSIONS_ENABLE=0

# Docker Compose: hostname used when generating a self-signed TLS certificate.
CERT_DNS=localhost
